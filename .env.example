# Port 5433 on the host so we never collide with a local Postgres on 5432.
DATABASE_URL=postgres://nextround:nextround@localhost:5433/nextround

PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

# Clerk — staff (recruiters, interviewers) only. Candidates never touch Clerk.
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Must match docker-jitsi-meet's .env exactly, or Prosody rejects our tokens.
# JITSI_DOMAIN is the public web origin; JITSI_XMPP_DOMAIN is what Prosody
# serves (docker-jitsi-meet's XMPP_DOMAIN) and is what belongs in the token sub.
JITSI_DOMAIN=localhost:8443
JITSI_XMPP_DOMAIN=meet.jitsi
JWT_APP_ID=nextround
JWT_APP_SECRET=change-me-to-a-long-random-string
JWT_ACCEPTED_AUDIENCES=nextround
JITSI_JWT_TTL_SECONDS=300

# How long a candidate invite link stays valid, measured from scheduled_at.
INVITE_TTL_HOURS=24

# Local development only. Skips Clerk and acts as the seeded recruiter.
# The server refuses to boot if this is set while NODE_ENV=production.
DEV_AUTH_BYPASS=1
DEV_CLERK_USER_ID=user_dev_seed
